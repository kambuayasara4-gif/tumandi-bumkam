# Konfigurasi Lingkungan TUMANDI (Tungkuwiri Mandiri Digital)

# 1. KONEKSI DATABASE (PostgreSQL untuk Cloud / SQLite untuk Lokal)
# Contoh Neon.tech / Supabase:
# DATABASE_URL="postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/tumandi?sslmode=require"
DATABASE_URL="file:./dev.db"

# 2. KEAMANAN SESI (SESSION SECRET KEY)
# Buat string acak panjang dan aman untuk menandatangani cookie session admin
SESSION_SECRET="tumandi-bumkam-tungkuwiri-mandiri-doyo-lama-secure-production-key-2026"

# 3. COOKIE SECURITY (Opsional: 'true' jika sudah menggunakan domain HTTPS)
COOKIE_SECURE="true"
